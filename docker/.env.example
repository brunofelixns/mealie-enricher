# PostgreSQL, NOVA and pricing require release 1.3.0 or later.
# Update this file, the Compose and the application image together.
# Public GitHub Container Registry image (no registry login required).
# Actions manages versions and updates latest after the full suite passes.
# Pin a verified tag or @sha256:... digest for controlled updates.
MEALIE_ENRICHER_IMAGE=ghcr.io/brunofelixns/mealie-enricher:latest

# Puerto publicado en el servidor y puerto interno del contenedor.
PUBLISHED_PORT=8000
PORT=8000

# Conexion Mealie: URL alcanzable desde el contenedor (edita ambos valores).
MEALIE_URL=https://mealie.example.com
MEALIE_API_TOKEN=
MEALIE_TIMEOUT_MS=30000

# PostgreSQL persistente incluido en Compose. Configura una contraseña propia.
POSTGRES_DB=mealie_enricher
POSTGRES_USER=mealie_enricher
POSTGRES_PASSWORD=change-this-password
# Vacio: Compose conecta al servicio postgres y pasa la contraseña por separado.
# Para una base externa, indica su URL; codifica los caracteres especiales de la clave.
# Usa comillas simples si la contraseña contiene $ o #.
DATABASE_URL=

# Tokens opcionales por hogar: sustituye guiones y otros signos del ID por "_".
# Se cargan desde este mismo archivo, sin modificar docker-compose.yml.
# MEALIE_API_TOKEN_ID_DE_TU_HOGAR=token-del-hogar

# Open Food Facts: mismos valores iniciales del Compose principal.
OFF_LANGUAGE=en
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_SEARCH_BASE_URL=https://search.openfoodfacts.org
OFF_SEARCH_RATE_LIMIT=10
OFF_PRODUCT_RATE_LIMIT=15
OFF_CACHE_TTL=86400
OFF_MAX_RETRIES=3
OFF_RETRY_BACKOFF_MS=500
OFF_USER_AGENT=MealieCalorieEstimator/1.0 (calories@example.com)

# Fallback LLM opcional; deshabilitado hasta configurar tu proveedor.
# OpenAI Agents SDK ejecuta el proveedor/modelo indicados aqui.
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_ENDPOINT_URL=/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_RATE_LIMIT=30
LLM_TEMPERATURE=0.1
# Vacios: 10/200 tokens para modelos clasicos; 1024/2048 para razonamiento.
# Con GPT-5/GPT-6, elimina los limites antiguos 10/200 o aumenta sus valores.
LLM_MAX_TOKENS_GRAMS=
LLM_MAX_TOKENS_NUTRIENTS=

# Estrategia: all o tagged.
ESTIMATE_STRATEGY=all
ESTIMATE_TAG=estimate
EVENT_DEBOUNCE_MS=2000

# Ruta heredada SQLite, usada solo sin DATABASE_URL fuera de este Compose.
CACHE_DB_PATH=/app/data/cache.db

# Historial persistente y enlaces hacia la interfaz Mealie.
# Si se deja vacio, se usa MEALIE_URL seguido de /recipe/{slug}.
MEALIE_RECIPE_URL_TEMPLATE=
HISTORY_MAX_ENTRIES=200
# 0 conserva todo el historial; un entero positivo limita los dias guardados.
HISTORY_RETENTION_DAYS=0
DEV_SEED_HISTORY=false
LOG_LEVEL=info

# BEDCA incluido en la imagen: no requiere descarga ni importación al arrancar.
CATALOG_ENABLED=true
CATALOG_DB_PATH=/opt/bedca/catalogos.duckdb
# Opcional: solo para importar un catálogo propio en /app/catalogs/catalogos.duckdb.
BEDCA_INPUT_DIR=./bedca
BEDCA_DATASET_VERSION=2026-08-19

# Resolver ambigüedades con OpenAI Decisions (opcional e independiente de LLM).
DECISIONS_ENABLED=false
OPENAI_API_KEY=
DECISIONS_API_KEY=
DECISIONS_MODEL=gpt-6-luna
DECISIONS_MIN_CONFIDENCE=0.9
DECISIONS_TIMEOUT_SECONDS=20
DECISIONS_MAX_CONCURRENCY=2
# Opcional: DECISIONS_API_KEY prevalece sobre OPENAI_API_KEY.

# Etiqueta NOVA opcional con la misma clave y limites de Decisions.
# No requiere activar CATALOG_ENABLED, DECISIONS_ENABLED ni LLM_ENABLED.
NOVA_ENABLED=false

# Precios opcionales de Mercadona; reutiliza OPENAI_API_KEY/DECISIONS_API_KEY.
PRICING_ENABLED=false
MERCADONA_POSTAL_CODE=27004
PRICING_DATA_DIR=/app/data/supermarkets
PRICING_SYNC_INTERVAL_HOURS=168
PRICING_AUTO_SYNC=true
PRICING_REQUEST_DELAY_SECONDS=2
PRICING_MAX_PRODUCTS=10000
PRICING_MAX_CANDIDATES=12
PRICING_MAX_DECISIONS_PER_RUN=500
# Token privado aleatorio de al menos 16 caracteres para los controles /pricing/*.
PRICING_ADMIN_TOKEN=
