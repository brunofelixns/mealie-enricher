# Imagen publicada en GitHub Container Registry.
# Sustituye el propietario y el tag por los de tu paquete real.
# Puedes fijar un tag de version o una referencia @sha256:... para actualizar de forma controlada.
MEALIE_ENRICHER_IMAGE=ghcr.io/tu-usuario-o-organizacion/mealie-enricher:latest

# Puerto publicado en el servidor y puerto interno del contenedor.
PUBLISHED_PORT=8000
PORT=8000

# Conexion Mealie: URL alcanzable desde el contenedor (edita ambos valores).
MEALIE_URL=https://mealie.example.com
MEALIE_API_TOKEN=
MEALIE_TIMEOUT_MS=30000

# Tokens opcionales por hogar: sustituye guiones y otros signos del ID por "_".
# Se cargan desde este mismo archivo, sin modificar docker-compose.yml.
# MEALIE_API_TOKEN_ID_DE_TU_HOGAR=token-del-hogar

# Open Food Facts: mismos valores iniciales del Compose principal.
OFF_LANGUAGE=en
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_SEARCH_BASE_URL=https://search.openfoodfacts.org
OFF_SEARCH_RATE_LIMIT=10
OFF_PRODUCT_RATE_LIMIT=15
OFF_CACHE_TTL=86400
OFF_MAX_RETRIES=3
OFF_RETRY_BACKOFF_MS=500
OFF_USER_AGENT=MealieCalorieEstimator/1.0 (calories@example.com)

# Fallback LLM opcional; deshabilitado hasta configurar tu proveedor.
# OpenAI Agents SDK ejecuta el proveedor/modelo indicados aqui.
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_ENDPOINT_URL=/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_RATE_LIMIT=30
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS_GRAMS=10
LLM_MAX_TOKENS_NUTRIENTS=200

# Estrategia: all o tagged.
ESTIMATE_STRATEGY=all
ESTIMATE_TAG=estimate
EVENT_DEBOUNCE_MS=2000

# Mantener esta ruta para guardar la cache en el volumen persistente.
CACHE_DB_PATH=/app/data/cache.db

# Historial temporal y enlaces hacia la interfaz Mealie.
# Si se deja vacio, se usa MEALIE_URL seguido de /recipe/{slug}.
MEALIE_RECIPE_URL_TEMPLATE=
HISTORY_MAX_ENTRIES=200
DEV_SEED_HISTORY=false
LOG_LEVEL=info
