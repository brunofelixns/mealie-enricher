# Variante con DuckDB y CSV originales incluidos, para uso no comercial.
# Imagen construida localmente; cambia esta referencia por su tag/digest
# de GHCR únicamente después de publicar y verificar esa variante.
MEALIE_ENRICHER_IMAGE=mealie-enricher:bedca

PUBLISHED_PORT=8000
PORT=8000
MEALIE_URL=https://mealie.example.com
MEALIE_API_TOKEN=
MEALIE_TIMEOUT_MS=30000
# MEALIE_API_TOKEN_ID_DE_TU_HOGAR=token-del-hogar

# Catálogo incluido en la imagen: no requiere importación ni carpeta de CSV.
CATALOG_ENABLED=true
CATALOG_DB_PATH=/opt/bedca/catalogos.duckdb
CACHE_DB_PATH=/app/data/cache.db

LLM_ENABLED=false
DECISIONS_ENABLED=false
# OPENAI_API_KEY=
DECISIONS_MODEL=gpt-6-luna
DECISIONS_MIN_CONFIDENCE=0.9
DECISIONS_TIMEOUT_SECONDS=20
DECISIONS_MAX_CONCURRENCY=2

# OFF se conserva como fallback cuando no existen candidatos en el catálogo.
OFF_LANGUAGE=es
OFF_USER_AGENT=MealieEnricher/1.13.0 (calories@example.com)
ESTIMATE_STRATEGY=all
EVENT_DEBOUNCE_MS=2000
HISTORY_MAX_ENTRIES=200
DEV_SEED_HISTORY=false
LOG_LEVEL=info
