# Mealie connection
MEALIE_URL=http://mealie:9000
MEALIE_API_TOKEN=your-dedicated-service-account-token

# Per-household API tokens (optional, overrides MEALIE_API_TOKEN)
# Set a token for each household that needs a different account:
# MEALIE_API_TOKEN_<HOUSEHOLD_ID>=your-household-specific-token

# Open Food Facts
OFF_LANGUAGE=de
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_SEARCH_BASE_URL=https://search.openfoodfacts.org
OFF_SEARCH_RATE_LIMIT=10
OFF_PRODUCT_RATE_LIMIT=15
OFF_CACHE_TTL=86400
OFF_USER_AGENT=MealieCalorieEstimator/1.0 (your@email.com)

# LLM estimation (optional - for custom units like Dose, Glas, Paeckchen)
LLM_ENABLED=true
LLM_API_KEY=your-mistral-api-key
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_ENDPOINT_URL=/chat/completions
LLM_MODEL=mistral-small-latest
LLM_RATE_LIMIT=30
LLM_TEMPERATURE=0.1
# Empty: 10/200 tokens for classic models; 1024/2048 for reasoning models.
# Explicit values override these defaults, including the reasoning budget.
LLM_MAX_TOKENS_GRAMS=
LLM_MAX_TOKENS_NUTRIENTS=

# Estimation strategy
# "all" (default) - estimate every recipe
# "tagged" - only estimate recipes with the tag specified by ESTIMATE_TAG
ESTIMATE_STRATEGY=all
ESTIMATE_TAG=estimate

# Quiet period before a recipe event is processed (rapid saves are coalesced,
# and writes per recipe are serialized to avoid duplicated ingredients)
EVENT_DEBOUNCE_MS=2000

# Execution history (/estimator/history)
# URL template for recipe links, {slug} is replaced with the recipe slug
# MEALIE_RECIPE_URL_TEMPLATE=http://mealie:9000/recipe/{slug}
# Maximum number of in-memory execution records kept
HISTORY_MAX_ENTRIES=200
# Seed the history with synthetic sample data on startup (for local dev only)
DEV_SEED_HISTORY=false

# Server
PORT=8000
LOG_LEVEL=info

# Catálogos persistentes DuckDB (preparar antes de activar).
CATALOG_ENABLED=false
CATALOG_DB_PATH=data/catalogs/catalogos.duckdb
# En Docker se fija /app/catalogs/catalogos.duckdb en un volumen separado.
BEDCA_INPUT_DIR=./data/bedca
BEDCA_DATASET_VERSION=2026-08-19

# Decisions resuelve candidatos; no calcula ni inventa nutrientes.
# Independiente del fallback LLM anterior. Usa exclusivamente la API OpenAI.
DECISIONS_ENABLED=false
OPENAI_API_KEY=
DECISIONS_MODEL=gpt-6-luna
DECISIONS_MIN_CONFIDENCE=0.9
DECISIONS_TIMEOUT_SECONDS=20
DECISIONS_MAX_CONCURRENCY=2
# Opcional: DECISIONS_API_KEY prevalece sobre OPENAI_API_KEY.
