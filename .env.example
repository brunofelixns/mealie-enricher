# Development Compose: build the current checkout with the included BEDCA catalog.
# For bare Python, use host paths for CACHE_DB_PATH and PRICING_DATA_DIR, and
# disable CATALOG_ENABLED or point CATALOG_DB_PATH to a prepared host catalog.
# Mealie connection
MEALIE_URL=http://mealie:9000
MEALIE_API_TOKEN=your-dedicated-service-account-token
MEALIE_TIMEOUT_MS=30000

# Per-household API tokens (optional, overrides MEALIE_API_TOKEN)
# Set a token for each household that needs a different account:
# MEALIE_API_TOKEN_<HOUSEHOLD_ID>=your-household-specific-token

# Open Food Facts
OFF_LANGUAGE=de
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_SEARCH_BASE_URL=https://search.openfoodfacts.org
OFF_SEARCH_RATE_LIMIT=10
OFF_PRODUCT_RATE_LIMIT=15
OFF_CACHE_TTL=86400
OFF_MAX_RETRIES=3
OFF_RETRY_BACKOFF_MS=500
OFF_USER_AGENT=MealieCalorieEstimator/1.0 (your@email.com)

# LLM estimation (optional - for custom units like Dose, Glas, Paeckchen)
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_ENDPOINT_URL=/chat/completions
LLM_MODEL=mistral-small-latest
LLM_RATE_LIMIT=30
LLM_TEMPERATURE=0.1
# Empty: 10/200 tokens for classic models; 1024/2048 for reasoning models.
# Explicit values override these defaults, including the reasoning budget.
LLM_MAX_TOKENS_GRAMS=
LLM_MAX_TOKENS_NUTRIENTS=

# Estimation strategy
# "all" (default) - estimate every recipe
# "tagged" - only estimate recipes with the tag specified by ESTIMATE_TAG
ESTIMATE_STRATEGY=all
ESTIMATE_TAG=estimate

# Quiet period before a recipe event is processed (rapid saves are coalesced,
# and writes per recipe are serialized to avoid duplicated ingredients)
EVENT_DEBOUNCE_MS=2000

# PostgreSQL used by Docker Compose. Change the development password.
POSTGRES_DB=mealie_enricher
POSTGRES_USER=mealie_enricher
POSTGRES_PASSWORD=change-this-password
# Compose constructs the internal URL and passes credentials separately.
# For a source-only run, set a URL to your PostgreSQL server to persist history.
# Example: postgresql+psycopg://user:URL_ENCODED_PASSWORD@localhost:5432/mealie_enricher
# Empty outside Compose preserves the legacy SQLite cache + memory-only history.
DATABASE_URL=
CACHE_DB_PATH=/app/data/cache.db

# Execution history (/estimator/history)
# URL template for recipe links, {slug} is replaced with the recipe slug
# Empty uses MEALIE_URL followed by /recipe/{slug}.
MEALIE_RECIPE_URL_TEMPLATE=
# Default history page size (persistent rows are not deleted by this limit).
HISTORY_MAX_ENTRIES=200
# Persistent history retention in days; 0 keeps all executions.
HISTORY_RETENTION_DAYS=0
# Seed the history with synthetic sample data on startup (for local dev only)
DEV_SEED_HISTORY=false

# Server
PORT=8000
PUBLISHED_PORT=8000
LOG_LEVEL=info

# BEDCA ya está incluido en la imagen; no requiere importar al arrancar.
CATALOG_ENABLED=true
CATALOG_DB_PATH=/opt/bedca/catalogos.duckdb
# Solo para construir la imagen o importar un catálogo propio en /app/catalogs.
BEDCA_INPUT_DIR=./data/bedca
BEDCA_DATASET_VERSION=2026-08-19

# Decisions resuelve candidatos; no calcula ni inventa nutrientes.
# Independiente del fallback LLM anterior. Usa exclusivamente la API OpenAI.
DECISIONS_ENABLED=false
OPENAI_API_KEY=
DECISIONS_API_KEY=
DECISIONS_MODEL=gpt-6-luna
DECISIONS_MIN_CONFIDENCE=0.9
DECISIONS_TIMEOUT_SECONDS=20
DECISIONS_MAX_CONCURRENCY=2
# Opcional: DECISIONS_API_KEY prevalece sobre OPENAI_API_KEY.

# Etiqueta NOVA estimada con Decisions; independiente de CATALOG/DECISIONS_ENABLED.
# Reutiliza la clave OPENAI_API_KEY/DECISIONS_API_KEY y los limites DECISIONS_*.
NOVA_ENABLED=false

# Optional supermarket prices: local DuckDB, independent of nutrition/BEDCA.
PRICING_ENABLED=false
MERCADONA_POSTAL_CODE=27004
PRICING_DATA_DIR=/app/data/supermarkets
# Weekly interval; manual sync does not postpone the next scheduled run.
PRICING_SYNC_INTERVAL_HOURS=168
PRICING_AUTO_SYNC=true
PRICING_REQUEST_DELAY_SECONDS=2
PRICING_MAX_PRODUCTS=10000
PRICING_MAX_CANDIDATES=12
PRICING_MAX_DECISIONS_PER_RUN=500
# Private random token, at least 16 characters, for /pricing/* controls.
PRICING_ADMIN_TOKEN=
