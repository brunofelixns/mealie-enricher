{
  "id": "llm-nutrients-fenced",
  "area": "llm",
  "contracts": [
    "C24",
    "C40"
  ],
  "input": {
    "food_name": "synthetic food",
    "content": "```json\n{\"kcal\":250,\"protein\":4,\"fat\":8,\"saturatedFat\":10}\n```"
  },
  "environment": {
    "MEALIE_API_TOKEN_abc_def": "synthetic-lower",
    "MEALIE_API_TOKEN_ABC_upper": "synthetic-upper",
    "MEALIE_API_TOKEN": "test-token",
    "MEALIE_URL": "http://127.0.0.1:18743",
    "OFF_LANGUAGE": "de",
    "OFF_SEARCH_RATE_LIMIT": "10000",
    "OFF_PRODUCT_RATE_LIMIT": "10000",
    "LLM_ENABLED": "true",
    "LLM_API_KEY": "synthetic-key",
    "LLM_BASE_URL": "https://llm.test/v1",
    "LLM_ENDPOINT_URL": "/custom-completions",
    "LLM_MODEL": "mistral-small-latest",
    "LLM_RATE_LIMIT": "10000",
    "EVENT_DEBOUNCE_MS": "0",
    "ESTIMATE_STRATEGY": "all"
  },
  "external_responses": [
    {
      "status": 200,
      "json": {
        "choices": [
          {
            "message": {
              "content": "```json\n{\"kcal\":250,\"protein\":4,\"fat\":8,\"saturatedFat\":10}\n```"
            }
          }
        ]
      }
    }
  ],
  "expected_requests": [
    {
      "method": "POST",
      "url": "https://llm.test/v1/custom-completions",
      "json": {
        "model": "mistral-small-latest",
        "messages": [
          {
            "role": "user",
            "content": "Estimate nutritional values per 100g for \"synthetic food\". Return ONLY valid JSON with these keys (all numbers, no units): {\"kcal\":0,\"protein\":0,\"carbs\":0,\"fat\":0,\"saturatedFat\":0,\"transFat\":0,\"fiber\":0,\"sugar\":0,\"sodium\":0,\"cholesterol\":0}. Use typical values for the food. No explanation, no markdown."
          }
        ],
        "temperature": 0.1,
        "max_tokens": 200
      }
    }
  ],
  "expected_result": {
    "kcalPer100g": 250,
    "proteinPer100g": 4,
    "carbsPer100g": null,
    "fatPer100g": 8,
    "saturatedFatPer100g": 10,
    "transFatPer100g": null,
    "unsaturatedFatPer100g": -2,
    "fiberPer100g": null,
    "sugarPer100g": null,
    "sodiumPer100g": null,
    "cholesterolPer100g": null
  }
}
